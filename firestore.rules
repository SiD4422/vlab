rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: get caller's user document ──────────────────────────────────
    function callerDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // ── Helper: check org_id match ───────────────────────────────────────────
    function sameOrg(resourceData) {
      return callerDoc().org_id == resourceData.org_id;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // USERS
    // ─────────────────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Read your own doc, or teacher reads a student in same org
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        sameOrg(resource.data)
      );

      // Create: invite code must exist, be unexpired, and match the org being claimed
      allow create: if request.auth != null &&
        request.auth.uid == userId &&
        (
          // SRM users can omit invite code (org_id defaults to srm_univ)
          request.resource.data.org_id == 'srm_univ' ||
          (
            exists(/databases/$(database)/documents/invite_codes/$(request.resource.data.invite_code)) &&
            get(/databases/$(database)/documents/invite_codes/$(request.resource.data.invite_code)).data.expires_at > request.time &&
            get(/databases/$(database)/documents/invite_codes/$(request.resource.data.invite_code)).data.org_id == request.resource.data.org_id &&
            get(/databases/$(database)/documents/invite_codes/$(request.resource.data.invite_code)).data.revoked == false
          )
        );

      // Update: only yourself, cannot change org_id or role
      allow update: if request.auth.uid == userId &&
        request.resource.data.org_id == resource.data.org_id &&
        request.resource.data.role == resource.data.role;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // CLASSES
    // ─────────────────────────────────────────────────────────────────────────
    match /classes/{classId} {
      allow read: if request.auth != null && sameOrg(resource.data);
      allow write: if request.auth != null &&
        callerDoc().role == 'teacher' &&
        sameOrg(resource.data);
    }

    // ─────────────────────────────────────────────────────────────────────────
    // SUBMISSIONS / LAB RECORDS
    // ─────────────────────────────────────────────────────────────────────────
    match /submissions/{submissionId} {
      allow read: if request.auth != null && sameOrg(resource.data);
      // Students can only create/update their OWN submissions — prevents grade overwriting
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.studentUid
        && sameOrg(request.resource.data);
      allow update: if request.auth != null
        && (
          // Student updating their own un-graded submission
          (request.auth.uid == resource.data.studentUid && resource.data.teacherScore == null)
          ||
          // Teacher grading a submission in their org
          (callerDoc().role == 'teacher' && sameOrg(resource.data))
        );
    }

    // ─────────────────────────────────────────────────────────────────────────
    // GROUPS
    // ─────────────────────────────────────────────────────────────────────────
    match /groups/{groupId} {
      allow read, write: if request.auth != null && sameOrg(resource.data);
    }

    // ─────────────────────────────────────────────────────────────────────────
    // ORGANIZATIONS
    // Anyone logged in can read their own org document (needed for CollegeContext).
    // Only the backend (Admin SDK) can write.
    // ─────────────────────────────────────────────────────────────────────────
    match /organizations/{orgId} {
      allow read: if request.auth != null && callerDoc().org_id == orgId;
      allow write: if false; // Write only via Admin SDK
    }

    // ─────────────────────────────────────────────────────────────────────────
    // INVITE CODES
    // Public read so unauthenticated signup flow can validate a code.
    // Write only via Admin SDK.
    // ─────────────────────────────────────────────────────────────────────────
    match /invite_codes/{code} {
      allow read: if true;
      allow write: if false;
    }
  }
}
